{% liquid
  assign background_mobile = section.settings.background_mobile | default: section.settings.background_desktop
  assign button_link = section.settings.button_link | default: routes.all_products_collection_url
%}

<div
  class="collection-banner"
  style="
    --collection-banner-background-desktop: {% if section.settings.background_desktop != blank %}url('{{ section.settings.background_desktop | image_url: width: 2400 | escape }}'){% else %}none{% endif %};
    --collection-banner-background-mobile: {% if background_mobile != blank %}url('{{ background_mobile | image_url: width: 1000 | escape }}'){% else %}none{% endif %};
    --collection-banner-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --collection-banner-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --collection-banner-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --collection-banner-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  <div class="collection-banner__inner">
    <div class="collection-banner__content">
      {% if section.settings.heading != blank or section.settings.heading_highlight != blank %}
        <div class="collection-banner__heading">
          <h2>
            {{ section.settings.heading | escape }}
            {% if section.settings.heading_highlight != blank %}
              <span>{{ section.settings.heading_highlight | escape }}</span>
            {% endif %}
          </h2>
        </div>
      {% endif %}

      {% if section.settings.description_mobile != blank %}
        <div class="collection-banner__description">
          <p>{{ section.settings.description_mobile | escape }}</p>
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="collection-banner__button-wrapper">
          <a class="collection-banner__button" href="{{ button_link | escape }}">
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .collection-banner {
    padding: var(--collection-banner-padding-top-mobile) 16px var(--collection-banner-padding-bottom-mobile);
    background-color: #080808;
    background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), var(--collection-banner-background-mobile);
    background-size: cover;
    background-position: center;
    text-align: center;
  }

  .collection-banner__inner {
    display: grid;
    max-width: 1248px;
    margin: 0 auto;
  }

  .collection-banner__inner::before {
    content: "";
    grid-area: 1 / 1;
    aspect-ratio: 343 / 361;
    pointer-events: none;
  }

  .collection-banner__content {
    grid-area: 1 / 1;
    align-self: center;
  }

  .collection-banner__heading {
    max-width: 816px;
    margin: 0 auto;
  }

  .collection-banner__heading h2 {
    margin: 0;
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.4px;
    text-transform: uppercase;
  }

  .collection-banner__heading span {
    color: #bb9e6b;
  }

  .collection-banner__description {
    max-width: 341px;
    margin: 16px auto 0;
  }

  .collection-banner__description p {
    margin: 0;
    color: #b5ab87;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.3;
  }

  .collection-banner__button-wrapper {
    margin-top: 24px;
  }

  .collection-banner__button {
    display: block;
    box-sizing: border-box;
    padding: 14.6px 16px;
    border: 1px solid rgba(255, 230, 137, 0.4);
    background: #bb9e6b;
    color: #000;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.7px;
    text-decoration: none;
  }

  .collection-banner__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  @media screen and (min-width: 750px) {
    .collection-banner {
      padding: var(--collection-banner-padding-top-desktop) clamp(24px, 6.667vw, 96px) var(--collection-banner-padding-bottom-desktop);
      background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), var(--collection-banner-background-desktop);
      background-size: 100% 190.14%;
      background-position: center 40.737%;
    }

    .collection-banner__inner::before {
      aspect-ratio: 1248 / 266;
    }

    .collection-banner__heading h2 {
      font-size: 32px;
      letter-spacing: -0.64px;
    }

    .collection-banner__description {
      display: none;
    }

    .collection-banner__button-wrapper {
      margin-top: 40px;
    }

    .collection-banner__button {
      display: inline-block;
      width: 238px;
      padding: 15.4px 16px;
      font-size: 16px;
      letter-spacing: 0.8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_desktop",
      "label": "Desktop background"
    },
    {
      "type": "image_picker",
      "id": "background_mobile",
      "label": "Mobile background",
      "info": "Uses desktop background when empty."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ethos & Ink is more than what you wear. Next Drop"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted heading",
      "default": "It is what you stand for."
    },
    {
      "type": "textarea",
      "id": "description_mobile",
      "label": "Mobile description",
      "default": "Runs of 250 sell out. Coalition members get 24-hour early access before every public release — plus 10% off your first order."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Collection banner"
    }
  ]
}
{% endschema %}

