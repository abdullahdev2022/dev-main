{% liquid
  assign section_heading_eyebrow = section.settings.eyebrow
  assign section_heading = section.settings.heading

  assign main_image = section.settings.main_image
  assign main_decorative_image = section.settings.main_decorative_image
  assign step_two_image = section.settings.step_two_image
  assign step_three_image = section.settings.step_three_image

  assign connector_one_image = section.settings.connector_one_image
  assign connector_two_image = section.settings.connector_two_image

  assign section_bg_color = section.settings.background_color
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop

  assign main_image_alt = main_image.alt | default: 'Product and mushroom blend'
  assign step_two_image_alt = step_two_image.alt | default: 'Coffee with mushroom blend'
  assign step_three_image_alt = step_three_image.alt | default: 'Mushroom blend liquid'
%}

<section
  id="shopify-section-{{ section.id }}"
  class="effortless-steps"
  style="
    --effortless-steps-bg: {{ section_bg_color }};
    --effortless-steps-padding-top-mobile: {{ padding_top_mobile }}px;
    --effortless-steps-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --effortless-steps-padding-top-desktop: {{ padding_top_desktop }}px;
    --effortless-steps-padding-bottom-desktop: {{ padding_bottom_desktop }}px;
  "
>
  <div class="effortless-steps__container">

    <div class="effortless-steps__header">
      <div class="effortless-steps__eyebrow">
        <p>{{ section_heading_eyebrow }}</p>
      </div>

      <div class="effortless-steps__heading">
        <h2>{{ section_heading }}</h2>
      </div>
    </div>

    <div class="effortless-steps__content">

      {% if main_decorative_image != blank %}
        <div class="effortless-steps__main-decorative">
          {{
            main_decorative_image
            | image_url: width: 900
            | image_tag:
              loading: 'eager',
              widths: '300,450,600,750,900',
              sizes: '(min-width: 769px) 31.74vw, 279px',
              alt: ''
          }}
        </div>
      {% endif %}

      {% if main_image != blank %}
        <div class="effortless-steps__main-image">
          {{
            main_image
            | image_url: width: 1120
            | image_tag:
              loading: 'eager',
              widths: '341,560,700,900,1120',
              sizes: '(min-width: 769px) 38.89vw, 341px',
              alt: main_image_alt
          }}
        </div>
      {% endif %}

      {% for block in section.blocks %}
        {% liquid
          assign block_title = block.settings.title
          assign block_description = block.settings.description
          assign step_number = forloop.index
        %}

        {% if step_number == 1 %}
          <div
            class="effortless-steps__step effortless-steps__step--one"
            {{ block.shopify_attributes }}
          >
            <div class="effortless-steps__number">
              <span>{{ step_number }}</span>
            </div>

            <div class="effortless-steps__step-content">
              <div class="effortless-steps__step-title">
                <h3>{{ block_title }}</h3>
              </div>

              <div class="effortless-steps__step-description">
                <p>{{ block_description }}</p>
              </div>
            </div>
          </div>

        {% elsif step_number == 2 %}

          {% if step_two_image != blank %}
            <div class="effortless-steps__step-image effortless-steps__step-image--two">
              {{
                step_two_image
                | image_url: width: 420
                | image_tag:
                  loading: 'lazy',
                  widths: '140,280,420',
                  sizes: '(min-width: 769px) 14.31vw, 140px',
                  alt: step_two_image_alt
              }}
            </div>
          {% endif %}

          <div
            class="effortless-steps__step effortless-steps__step--two"
            {{ block.shopify_attributes }}
          >
            <div class="effortless-steps__number">
              <span>{{ step_number }}</span>
            </div>

            <div class="effortless-steps__step-content">
              <div class="effortless-steps__step-title">
                <h3>{{ block_title }}</h3>
              </div>

              <div class="effortless-steps__step-description">
                <p>{{ block_description }}</p>
              </div>
            </div>
          </div>

        {% elsif step_number == 3 %}

          {% if step_three_image != blank %}
            <div class="effortless-steps__step-image effortless-steps__step-image--three">
              {{
                step_three_image
                | image_url: width: 420
                | image_tag:
                  loading: 'lazy',
                  widths: '140,280,420',
                  sizes: '(min-width: 769px) 14.31vw, 140px',
                  alt: step_three_image_alt
              }}
            </div>
          {% endif %}

          <div
            class="effortless-steps__step effortless-steps__step--three"
            {{ block.shopify_attributes }}
          >
            <div class="effortless-steps__number">
              <span>{{ step_number }}</span>
            </div>

            <div class="effortless-steps__step-content">
              <div class="effortless-steps__step-title">
                <h3>{{ block_title }}</h3>
              </div>

              <div class="effortless-steps__step-description">
                <p>{{ block_description }}</p>
              </div>
            </div>
          </div>

        {% endif %}
      {% endfor %}

      {% if connector_one_image != blank %}
        <div class="effortless-steps__connector effortless-steps__connector--one">
          {{
            connector_one_image
            | image_url: width: 400
            | image_tag:
              loading: 'lazy',
              widths: '200,300,400',
              alt: ''
          }}
        </div>
      {% endif %}

      {% if connector_two_image != blank %}
        <div class="effortless-steps__connector effortless-steps__connector--two">
          {{
            connector_two_image
            | image_url: width: 400
            | image_tag:
              loading: 'lazy',
              widths: '200,300,400',
              alt: ''
          }}
        </div>
      {% endif %}

    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    background: var(--effortless-steps-bg);
    padding-top: var(--effortless-steps-padding-top-mobile);
    padding-bottom: var(--effortless-steps-padding-bottom-mobile);
  }

  .effortless-steps {
    width: 100%;
    overflow: hidden;
  }

  .effortless-steps__container {
    width: 100%;
    margin: 0 auto;
    padding: 0 16px;
  }

  .effortless-steps__header {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .effortless-steps__eyebrow {
    width: 100%;
    margin-bottom: 8px;
  }

  .effortless-steps__eyebrow p {
    margin: 0;
    color: #121212;
    font-family: "Assistant", sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 17.83px;
    text-transform: uppercase;
  }

  .effortless-steps__heading {
    width: 100%;
  }

  .effortless-steps__heading h2 {
    margin: 0;
    color: #121212;
    font-family: "Assistant", sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.72px;
  }

  .effortless-steps__content {
    position: relative;
    width: 100%;
    height: 780px;
    margin-top: 20px;
  }

  /* Main artwork */

  .effortless-steps__main-image {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: calc(100% - 1.676px);
    max-width: 341.324px;
    aspect-ratio: 341.324 / 348.349;
  }

  .effortless-steps__main-decorative {
    position: absolute;
    z-index: 1;
    top: 26.82px;
    left: 18.83%;
    width: 81.57%;
    max-width: 278.545px;
    aspect-ratio: 1;
  }

  .effortless-steps__main-image img,
  .effortless-steps__main-decorative img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Steps */

  .effortless-steps__step {
    position: absolute;
    z-index: 5;
  }

  .effortless-steps__step--one {
    top: 0;
    left: 0;
    width: 182.899px;
    height: 182.899px;
    padding: 30.171px;
    border-radius: 50%;
    background: #fffaf6;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }

  .effortless-steps__step-content {
    width: 100%;
  }

  .effortless-steps__step-title {
    width: 100%;
  }

  .effortless-steps__step-title h3 {
    margin: 0;
    color: #111;
    font-family: "Assistant", sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 19.42px;
    text-align: center;
  }

  .effortless-steps__step-description {
    width: 100%;
    margin-top: 8px;
  }

  .effortless-steps__step-description p {
    margin: 0;
    color: #605f5f;
    font-family: "Assistant", sans-serif;
    font-size: 12px;
    font-weight: 400;
    line-height: 14px;
  }

  .effortless-steps__number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .effortless-steps__number span {
    font-family: "Assistant", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 21.55px;
  }

  .effortless-steps__step--one .effortless-steps__number {
    position: absolute;
    top: 2.55px;
    left: 0;
  }

  /* Step images */

  .effortless-steps__step-image {
    position: absolute;
    z-index: 4;
    overflow: hidden;
    border-radius: 50%;
  }

  .effortless-steps__step-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .effortless-steps__step-image--two {
    top: 348px;
    left: 0;
    width: 140.402px;
    height: 140.402px;
  }

  .effortless-steps__step--two {
    top: 358px;
    left: 52.48%;
    width: 147px;
  }

  .effortless-steps__step--two .effortless-steps__number,
  .effortless-steps__step--three .effortless-steps__number {
    margin-bottom: 8px;
  }

  .effortless-steps__step--two .effortless-steps__step-title h3,
  .effortless-steps__step--three .effortless-steps__step-title h3 {
    text-align: left;
  }

  .effortless-steps__step--two .effortless-steps__step-description,
  .effortless-steps__step--three .effortless-steps__step-description {
    margin-top: 0;
  }

  /* Step 3 */

  .effortless-steps__step--three {
    top: 531px;
    left: 7.29%;
    width: 146px;
  }

  .effortless-steps__step-image--three {
    top: 522px;
    left: 52.19%;
    width: 140px;
    height: 140px;
  }

  /* Connectors */

  .effortless-steps__connector {
    position: absolute;
    z-index: 3;
    pointer-events: none;
  }

  .effortless-steps__connector img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .effortless-steps__connector--one {
    top: 421px;
    left: 31.68%;
    width: 99px;
    height: 114px;
    transform: rotate(50.61deg);
    transform-origin: center;
  }

  .effortless-steps__connector--two {
    top: 282px;
    left: 35.56%;
    width: 118px;
    height: 129px;
    transform: rotate(-48.25deg);
    transform-origin: center;
  }

  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} {
      padding-top: var(--effortless-steps-padding-top-desktop);
      padding-bottom: var(--effortless-steps-padding-bottom-desktop);
    }

    .effortless-steps__container {
      padding: 0;
    }

    .effortless-steps__header {
      position: relative;
      z-index: 10;
    }

    .effortless-steps__eyebrow p {
      font-size: clamp(16px, 1.111vw, 16px);
    }

    .effortless-steps__heading h2 {
      font-size: clamp(24px, 2.222vw, 32px);
      letter-spacing: clamp(-0.72px, -0.0667vw, -0.96px);
    }

    /*
      Figma desktop canvas:
      1440 x 600

      All coordinates below are percentages of that canvas.
      This keeps the entire composition proportional on smaller
      desktop/tablet widths instead of overflowing.
    */

    .effortless-steps__content {
      width: 100%;
      max-width: 1440px;
      height: min(41.667vw, 600px);
      margin: min(2.778vw, 40px) auto 0;
    }

    /* Main artwork */

    .effortless-steps__main-artwork {
      position: static;
    }

    .effortless-steps__main-image {
      top: 8.5%;
      left: 18.125%;
      width: 38.889%;
      max-width: none;
      height: 95.333%;
      aspect-ratio: auto;
    }

    .effortless-steps__main-decorative {
      top: 15.833%;
      left: 25.469%;
      width: 31.736%;
      max-width: none;
      height: auto;
      aspect-ratio: 1;
    }

    /* Step 1 */

    .effortless-steps__step--one {
      top: 0;
      left: 10%;
      width: 18.681%;
      height: 44.833%;
      padding: 3.333%;
    }

    .effortless-steps__step--one .effortless-steps__number {
      top: 0;
      left: 1.389%;
      width: 4.167%;
      height: 22.305%;
    }

    .effortless-steps__number span {
      font-size: clamp(16px, 1.786vw, 25.714px);
      line-height: 1.333;
    }

    .effortless-steps__step-title h3 {
      font-size: clamp(20px, 2.222vw, 32px);
      line-height: 0.9653;
    }

    .effortless-steps__step-description {
      margin-top: clamp(8px, 0.833vw, 12px);
    }

    .effortless-steps__step-description p {
      font-size: clamp(12px, 1.111vw, 16px);
      line-height: 1.3;
    }

    .effortless-steps__step--one .effortless-steps__step-description {
      width: 81.41%;
    }

    /* Step 2 image */

    .effortless-steps__step-image--two {
      top: 1.5%;
      left: 64.097%;
      width: 14.306%;
      height: auto;
      aspect-ratio: 1;
    }

    /* Step 2 content */

    .effortless-steps__step--two {
      top: 0;
      left: 79.583%;
      width: 15.208%;
    }

    .effortless-steps__step--two .effortless-steps__number,
    .effortless-steps__step--three .effortless-steps__number {
      width: 27.397%;
      height: auto;
      aspect-ratio: 1;
      margin-bottom: clamp(8px, 0.833vw, 12px);
    }

    .effortless-steps__step--two .effortless-steps__step-description,
    .effortless-steps__step--three .effortless-steps__step-description {
      margin-top: 0;
    }

    .effortless-steps__step--two .effortless-steps__step-title h3,
    .effortless-steps__step--three .effortless-steps__step-title h3 {
      text-align: center;
    }

    /* Step 3 image */

    .effortless-steps__step-image--three {
      top: 50.167%;
      left: 81.042%;
      width: 14.306%;
      height: auto;
      aspect-ratio: 1;
    }

    /* Step 3 content */

    .effortless-steps__step--three {
      top: 47.833%;
      left: 64.861%;
      width: 15.208%;
    }

    /* Connectors */

    .effortless-steps__connector--one {
      top: 33%;
      left: 73.472%;
      width: 10.069%;
      height: 28%;
      transform: rotate(50.61deg);
    }

    .effortless-steps__connector--two {
      top: 17.667%;
      left: 47.778%;
      width: 16.528%;
      height: 43.333%;
      transform: rotate(-48.25deg);
    }
  }
</style>

{% schema %}
{
  "name": "Effortless steps",
  "tag": "section",
  "class": "section-effortless-steps",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Effortless"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three steps to your daily dose"
    },
    {
      "type": "header",
      "content": "Main artwork"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main image"
    },
    {
      "type": "image_picker",
      "id": "main_decorative_image",
      "label": "Decorative image"
    },
    {
      "type": "header",
      "content": "Step images"
    },
    {
      "type": "image_picker",
      "id": "step_two_image",
      "label": "Step 2 image"
    },
    {
      "type": "image_picker",
      "id": "step_three_image",
      "label": "Step 3 image"
    },
    {
      "type": "header",
      "content": "Connector artwork"
    },
    {
      "type": "image_picker",
      "id": "connector_one_image",
      "label": "Connector 1"
    },
    {
      "type": "image_picker",
      "id": "connector_two_image",
      "label": "Connector 2"
    },
    {
      "type": "header",
      "content": "Section styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding desktop",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding desktop",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pick your blend"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Choose by goal, or grab a best seller. Every SLX is full-spectrum and sugar-free."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Effortless steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Pick your blend",
            "description": "Choose by goal, or grab a best seller. Every SLX is full-spectrum and sugar-free."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Add 1–2 tsp",
            "description": "Stir into coffee, tea, smoothies, or take it straight. 2–3× daily, no brewing."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Feel it work",
            "description": "Smooth taste, high absorption, no clumps, and no bitter aftertaste. That's it."
          }
        }
      ]
    }
  ]
}
{% endschema %}