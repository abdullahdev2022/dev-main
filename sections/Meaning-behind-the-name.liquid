{% liquid
  assign background_mobile = section.settings.background_mobile | default: section.settings.background_desktop
%}

<div
  class="name-story"
  style="
    --name-story-background-desktop: {% if section.settings.background_desktop != blank %}url('{{ section.settings.background_desktop | image_url: width: 2400 | escape }}'){% else %}none{% endif %};
    --name-story-background-mobile: {% if background_mobile != blank %}url('{{ background_mobile | image_url: width: 1000 | escape }}'){% else %}none{% endif %};
    --name-story-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --name-story-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --name-story-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --name-story-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  <div class="name-story__inner">
    <div class="name-story__header">
      {% if section.settings.subtitle != blank %}
        <div class="name-story__subtitle">
          <p>{{ section.settings.subtitle | escape }}</p>
        </div>
      {% endif %}

      {% if section.settings.heading != blank or section.settings.heading_highlight != blank %}
        <div class="name-story__heading">
          <h2>
            {{ section.settings.heading | escape }}
            {% if section.settings.heading_highlight != blank %}
              <span>{{ section.settings.heading_highlight | escape }}</span>
            {% endif %}
          </h2>
        </div>
      {% endif %}

      {% if section.settings.introduction != blank %}
        <div class="name-story__introduction">
          {{ section.settings.introduction }}
        </div>
      {% endif %}
    </div>

    <div class="name-story__cards">
      {% for block in section.blocks %}
        {% assign image_mobile = block.settings.image_mobile | default: block.settings.image %}
        <div
          class="name-story__card"
          style="
            --name-story-card-desktop: {% if block.settings.image != blank %}url('{{ block.settings.image | image_url: width: 1400 | escape }}'){% else %}none{% endif %};
            --name-story-card-mobile: {% if image_mobile != blank %}url('{{ image_mobile | image_url: width: 900 | escape }}'){% else %}none{% endif %};
          "
          {{ block.shopify_attributes }}
        >
          <div class="name-story__card-content">
            {% if block.settings.title != blank %}
              <div class="name-story__card-title">
                <h3>{{ block.settings.title | escape }}</h3>
              </div>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="name-story__card-text">
                <p>{{ block.settings.text | escape }}</p>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.description != blank %}
      <div class="name-story__description">
        {{ section.settings.description }}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .name-story {
    position: relative;
    isolation: isolate;
    background: #0c0805;
    padding: var(--name-story-padding-top-mobile) 16px var(--name-story-padding-bottom-mobile);
  }

  .name-story::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--name-story-background-mobile);
    background-size: 100% 100%;
    background-position: center;
    opacity: 0.6;
  }

  .name-story__inner {
    max-width: 1248px;
    margin: 0 auto;
  }

  .name-story__header {
    text-align: center;
  }

  .name-story__subtitle p {
    margin: 0 0 8px;
    color: #f2d06b;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 2.24px;
    text-transform: uppercase;
  }

  .name-story__heading h2 {
    margin: 0;
    color: #fff;
    font-size: 27px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.54px;
    text-transform: uppercase;
  }

  .name-story__heading span {
    color: #bb9e6b;
  }

  .name-story__introduction {
    max-width: 896px;
    margin: 16px auto 0;
    color: #b5ab87;
    font-size: 14px;
    line-height: 1.3;
  }

  .name-story__introduction p,
  .name-story__description p {
    margin: 0;
  }

  .name-story__introduction p + p,
  .name-story__description p + p {
    margin-top: 8px;
  }

  .name-story__cards {
    display: grid;
    gap: 20px;
    margin-top: 40px;
  }

  .name-story__card {
    display: grid;
    border: 3px solid #bb9e6b;
    background-image: linear-gradient(to top, rgba(11, 6, 3, 0.7) 35.577%, rgba(28, 27, 27, 0.14)), var(--name-story-card-mobile);
    background-position: center;
    background-size: cover;
  }

  .name-story__card::before {
    content: "";
    grid-area: 1 / 1;
    aspect-ratio: 337 / 316;
    pointer-events: none;
  }

  .name-story__card:nth-child(2) {
    background-image: linear-gradient(to right, rgba(11, 6, 3, 0.7) 35.577%, rgba(28, 27, 27, 0.14)), var(--name-story-card-mobile);
  }

  .name-story__card-content {
    grid-area: 1 / 1;
    align-self: end;
    padding: 24px 12px;
  }

  .name-story__card-title h3 {
    margin: 0 0 12px;
    color: #bb9e6b;
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 1.16px;
    text-transform: uppercase;
  }

  .name-story__card-text p {
    max-width: 481px;
    margin: 0;
    color: rgba(236, 226, 209, 0.9);
    font-size: 14px;
    line-height: 1.4;
    letter-spacing: 0.08px;
  }

  .name-story__description {
    max-width: 699px;
    margin: 40px 0 0 auto;
    color: rgba(236, 226, 209, 0.9);
    font-size: 14px;
    line-height: 1.4;
  }

  @media screen and (min-width: 750px) {
    .name-story {
      padding: var(--name-story-padding-top-desktop) clamp(24px, 6.667vw, 96px) var(--name-story-padding-bottom-desktop);
    }

    .name-story::before {
      background-image: linear-gradient(to bottom, transparent 42.015%, #000), var(--name-story-background-desktop);
      background-size: cover;
      opacity: 1;
    }

    .name-story__heading h2 {
      font-size: 32px;
      letter-spacing: -0.64px;
    }

    .name-story__introduction,
    .name-story__description,
    .name-story__card-text p {
      font-size: 16px;
    }

    .name-story__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .name-story__card,
    .name-story__card:nth-child(2) {
      background-image: linear-gradient(to right, rgba(11, 6, 3, 0.7) 35.577%, rgba(28, 27, 27, 0.14)), var(--name-story-card-desktop);
    }

    .name-story__card::before {
      aspect-ratio: 608 / 316;
    }

    .name-story__card-content {
      padding: 48px 24px;
    }

    .name-story__card-title h3 {
      font-size: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Meaning behind the name",
  "tag": "section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "image_picker",
      "id": "background_desktop",
      "label": "Desktop background"
    },
    {
      "type": "image_picker",
      "id": "background_mobile",
      "label": "Mobile background"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Principles over profit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The meaning behind"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted heading",
      "default": "the name"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>Valor Heritage Collection — honoring the original Badge of Military Merit, est. August 7, 1782.<br>Every piece is a numbered run of 250</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Bottom description",
      "default": "<p>Every design begins with real artists creating real art. Our work is developed in-house with the detail, intention and human character that have always defined Based Trading Cards. These are not disposable graphics created to chase a moment. They are pieces designed to tell a story, start a conversation and mean something to the person wearing them.</p>"
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Uses desktop image when empty."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meaning behind the name",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "ETHOS",
            "text": "The principles that guide us — the values we carry, the convictions we stand behind and the character we display when nobody is watching."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "INK",
            "text": "Conviction made visible. It represents the values written so deeply into who you are that you are willing to wear them for life."
          }
        }
      ]
    }
  ]
}
{% endschema %}

