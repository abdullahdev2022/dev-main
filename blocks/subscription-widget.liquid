{% doc %}
  Renders a custom subscription purchase widget for the current product.
{% enddoc %}

{% stylesheet %}
  .subscription-widget-inner,
  .subscription-widget-inner *,
  .subscription-widget-inner *::before,
  .subscription-widget-inner *::after {
    box-sizing: border-box;
  }

  .subscription-widget-inner {
    --widget-text: #2d2926;
    --widget-muted: #6b675e;
    --widget-yellow: #f1eb9c;
    --widget-yellow-soft: rgba(241, 235, 156, 0.5);
    --widget-border: rgba(45, 41, 38, 0.15);
    --widget-font: var(--font-body-family, Arial, sans-serif);
    --widget-heading-font: var(--font-heading-family, Arial, sans-serif);
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    color: var(--widget-text);
    font-family: var(--widget-font);
  }

  .subscription-widget-plan-main {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 16px;
    border: 0;
    border-radius: 12px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--widget-border);
  }

  .subscription-widget_subscribe-save {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .subscription-widget-plan-head {
    display: flex !important;
    align-items: center;
    align-self: stretch !important;
    gap: 9px;
    width: 100% !important;
    max-width: none !important;
    inline-size: 100% !important;
    min-height: 24px;
    margin: 0;
    cursor: pointer;
  }

  .subscription-widget__head-inner {
    position: relative;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
  }

  .subscription-widget__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    opacity: 0;
    pointer-events: none;
  }

  .subscription-widget__radio {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border: 1px solid var(--widget-text);
    border-radius: 50%;
    background: transparent;
  }

  .subscription-widget__radio::after {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--widget-text);
    content: '';
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .subscription-widget__input:checked + .subscription-widget__radio::after {
    opacity: 1;
    transform: scale(1);
  }

  .subscription-widget-plan-main:has(.subscription-widget__input:focus-visible) {
    outline: 2px solid var(--widget-text);
    outline-offset: 3px;
  }

  .subscription-widget__plan-name {
    flex: 1 1 auto;
    min-width: 0;
  }

  .subscription-widget__plan-name p {
    margin: 0;
    color: var(--widget-text);
    font-family: var(--widget-heading-font);
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    text-transform: uppercase;
  }

  .subscription-widget__price-main {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    flex: 0 0 auto;
    gap: 4px;
    margin-left: auto;
    white-space: nowrap;
  }

  .subscription-widget__compare-price {
    color: var(--widget-muted);
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    text-decoration: line-through;
  }

  .subscription-widget__price {
    color: var(--widget-text);
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
  }

  .subscription-widget__point-head,
  .subscription-widget__point-head ul,
  .subscription-widget__days-plan {
    width: 100%;
  }

  .subscription-widget__point-head ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 28px;
    margin: 0;
    padding: 4px 0 0;
    list-style: none;
  }

  .subscription-widget__point-head li {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--widget-text);
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
  }

  .subscription-widget__point-head svg {
    flex: 0 0 12px;
    width: 12px;
    height: 12px;
  }

  .subscription-widget__days-plan {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    padding-top: 2px;
  }

  .subscription-widget__ships-every {
    color: var(--widget-muted);
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    white-space: nowrap;
  }

  .subscription-widget__days-plan > button.subscription-widget__days-plan {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 0;
    height: 24px;
    margin: 0;
    padding: 4px 12px;
    border: 0;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(45, 41, 38, 0.18);
    color: var(--widget-text);
    font-family: var(--widget-font);
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }

  .subscription-widget__days-plan > button.subscription-widget__days-plan:hover {
    box-shadow: inset 0 0 0 1.5px var(--widget-text);
  }

  .subscription-widget__days-plan > button.subscription-widget__days-plan:active {
    transform: scale(0.97);
  }

  .subscription-widget__days-plan > button.subscription-widget__days-plan:focus-visible {
    outline: 2px solid var(--widget-text);
    outline-offset: 2px;
  }

  .subscription-widget__days-plan > button.subscription-widget__days-plan.is-selected,
  .subscription-widget__days-plan > button.subscription-widget__days-plan[aria-pressed='true'] {
    background: var(--widget-yellow);
    box-shadow: inset 0 0 0 1.5px var(--widget-text);
  }

  .subscription-widget-plan_one-time {
    border-radius: 8px;
  }

  .subscription-widget_subscribe-save:has(.subscription-widget__input:checked) {
    background: var(--widget-yellow-soft);
    box-shadow: inset 0 0 0 1.5px var(--widget-text);
  }

  .subscription-widget-plan_one-time:has(.subscription-widget__input:checked) {
    box-shadow: inset 0 0 0 1.5px var(--widget-text);
  }

  .subscription-widget_subscribe-save:not(:has(.subscription-widget__input:checked))
    .subscription-widget__days-plan > button {
    opacity: 0.65;
  }

  @media screen and (max-width: 749px) {
    .subscription-widget-plan-main {
      padding: 14px;
    }

    .subscription-widget__plan-name p,
    .subscription-widget__price {
      font-size: 15px;
    }

    .subscription-widget__point-head ul {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .subscription-widget__days-plan {
      row-gap: 8px;
    }
  }

  @media screen and (max-width: 390px) {
    .subscription-widget-plan-head {
      flex-wrap: wrap;
    }

    .subscription-widget-plan-head > .subscription-widget__price-main {
      justify-content: flex-start;
      width: calc(100% - 25px);
      margin-top: 2px;
      margin-left: 25px;
    }
  }
{% endstylesheet %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign allocations = current_variant.selling_plan_allocations %}
{% assign initial_allocation = allocations.first %}
{% assign first_available_group_selected = false %}

{% if product.selling_plan_groups.size > 0 %}
  <subscription-widget-controller
    class="subscription-widget-inner"
    data-sub-widget
    data-variant-id="{{ current_variant.id }}"
  >
    {% for group in product.selling_plan_groups %}
      {% assign group_allocations = allocations | where: 'selling_plan_group_id', group.id %}
      {% assign group_initial = group_allocations.first %}
      {% assign group_selected = false %}
      {% if group_allocations.size > 0 and first_available_group_selected == false %}
        {% assign group_selected = true %}
        {% assign first_available_group_selected = true %}
      {% endif %}

      <div
        class="subscription-widget-plan-main subscription-widget_subscribe-save"
        data-plan-group
        data-group-id="{{ group.id }}"
        {% if group_allocations.size == 0 %}hidden{% endif %}
      >
        <label class="subscription-widget-plan-head">
          <span class="subscription-widget__head-inner">
            <input
              class="subscription-widget__input"
              type="radio"
              name="purchase_type_{{ section.id }}"
              value="{{ group.id }}"
              data-purchase-type
              {% if group_selected %}checked{% endif %}
            >
            <span class="subscription-widget__radio"></span>
          </span>

          <span class="subscription-widget__plan-name">
            <p>{{ group.name }}</p>
          </span>

          <span class="subscription-widget__price-main">
            <span class="subscription-widget__compare-price" data-group-compare-price>
              {{ group_initial.compare_at_price | money }}
            </span>
            <span class="subscription-widget__price" data-group-plan-price>
              {{ group_initial.price | money }}
            </span>
          </span>
        </label>

        <div class="subscription-widget__point-head">
          <ul>
            <li>
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
                <path d="M1.875 6.375L4.875 9.375L10.125 2.625" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span>Exclusive subscriber gifts</span>
            </li>
            <li>
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
                <path d="M1.875 6.375L4.875 9.375L10.125 2.625" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span>Earn 5% back in rewards</span>
            </li>
            <li>
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
                <path d="M1.875 6.375L4.875 9.375L10.125 2.625" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span>Free shipping, always</span>
            </li>
            <li>
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
                <path d="M1.875 6.375L4.875 9.375L10.125 2.625" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span>Skip, pause, or cancel anytime</span>
            </li>
          </ul>
        </div>

        <div class="subscription-widget__days-plan">
          <span class="subscription-widget__ships-every">Ships every</span>
          {% assign first_available_plan_selected = false %}
          {% for selling_plan in group.selling_plans %}
            {% assign plan_available = false %}
            {% for allocation in group_allocations %}
              {% if allocation.selling_plan.id == selling_plan.id %}
                {% assign plan_available = true %}
                {% break %}
              {% endif %}
            {% endfor %}
            {% assign plan_selected = false %}
            {% if plan_available and first_available_plan_selected == false %}
              {% assign plan_selected = true %}
              {% assign first_available_plan_selected = true %}
            {% endif %}
            <button
              type="button"
              class="subscription-widget__days-plan{% if plan_selected %} is-selected{% endif %}"
              data-plan-item
              data-plan-id="{{ selling_plan.id }}"
              aria-pressed="{% if plan_selected %}true{% else %}false{% endif %}"
              {% unless plan_available %}hidden disabled{% endunless %}
            >
              {{ selling_plan.options.first.value | remove: 'Deliver ' | capitalize }}
            </button>
          {% endfor %}
        </div>
      </div>
    {% endfor %}

    {% unless product.requires_selling_plan %}
      <label
        class="subscription-widget-plan-main subscription-widget-plan_one-time subscription-widget-plan-head"
        data-onetime-card
      >
        <span class="subscription-widget__head-inner">
          <input
            class="subscription-widget__input"
            type="radio"
            name="purchase_type_{{ section.id }}"
            value="onetime"
            data-purchase-type
            {% unless first_available_group_selected %}checked{% endunless %}
          >
          <span class="subscription-widget__radio"></span>
        </span>

        <span class="subscription-widget__plan-name">
          <p>One-time purchase</p>
        </span>

        <span class="subscription-widget__price-main">
          <span class="subscription-widget__price" data-onetime-price>
            {{ current_variant.price | money }}
          </span>
        </span>
      </label>
    {% endunless %}

    <input
      type="hidden"
      name="selling_plan"
      value="{{ initial_allocation.selling_plan.id }}"
      data-selling-plan-input
    >

    <script type="application/json" data-subscription-variants>
      {
        {% for variant in product.variants %}
          "{{ variant.id }}": {
            "oneTimePrice": {{ variant.price | money | json }},
            "allocations": [
              {% for allocation in variant.selling_plan_allocations %}
                {
                  "planId": "{{ allocation.selling_plan.id }}",
                  "groupId": {{ allocation.selling_plan_group_id | json }},
                  "price": {{ allocation.price | money | json }},
                  "comparePrice": {{ allocation.compare_at_price | money | json }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      }
    </script>
  </subscription-widget-controller>
{% endif %}

{% javascript %}
  if (!customElements.get('subscription-widget-controller')) {
    class SubscriptionWidgetController extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;

        this.productSection = this.closest('.shopify-section');
        this.variantData = JSON.parse(this.querySelector('[data-subscription-variants]').textContent);
        this.groupCards = [...this.querySelectorAll('[data-plan-group]')];
        this.planButtons = [...this.querySelectorAll('[data-plan-item]')];
        this.sellingPlanInput = this.querySelector('[data-selling-plan-input]');
        this.oneTimePriceOutput = this.querySelector('[data-onetime-price]');
        this.productForm = this.productSection?.querySelector('product-form-component form[action*="/cart/add"]');

        this.handleClick = this.handleClick.bind(this);
        this.handlePurchaseChange = this.handlePurchaseChange.bind(this);
        this.handleVariantChange = this.handleVariantChange.bind(this);

        this.connectSellingPlanInput();
        this.addEventListener('click', this.handleClick);
        this.addEventListener('change', this.handlePurchaseChange);
        document.addEventListener('change', this.handleVariantChange);
        this.syncVariant(this.getSelectedVariantId());
      }

      disconnectedCallback() {
        document.removeEventListener('change', this.handleVariantChange);
      }

      connectSellingPlanInput() {
        if (!this.productForm || !this.sellingPlanInput) return;
        let productFormId = this.productForm.getAttribute('id');
        if (!productFormId) {
          productFormId = `product-form-${Date.now()}`;
          this.productForm.setAttribute('id', productFormId);
        }
        this.sellingPlanInput.setAttribute('form', productFormId);
      }

      getSelectedVariantId() {
        const selectedVariant = this.productSection?.querySelector('variant-picker input[data-variant-id]:checked');
        return selectedVariant?.dataset.variantId || this.dataset.variantId;
      }

      getAllocation(variant, planId) {
        return variant?.allocations.find((allocation) => allocation.planId === String(planId));
      }

      getActiveButton(groupCard) {
        return groupCard.querySelector('[data-plan-item][aria-pressed="true"]');
      }

      updateGroupCard(groupCard, variant) {
        const buttons = [...groupCard.querySelectorAll('[data-plan-item]')];
        buttons.forEach((button) => {
          const allocation = this.getAllocation(variant, button.dataset.planId);
          button.disabled = !allocation;
          button.hidden = !allocation;
        });

        let activeButton = this.getActiveButton(groupCard);
        if (!activeButton || activeButton.disabled) {
          activeButton = buttons.find((button) => !button.disabled);
        }

        if (!activeButton) {
          groupCard.hidden = true;
          return;
        }

        groupCard.hidden = false;
        buttons.forEach((button) => {
          const selected = button === activeButton;
          button.classList.toggle('is-selected', selected);
          button.setAttribute('aria-pressed', String(selected));
        });

        const allocation = this.getAllocation(variant, activeButton.dataset.planId);
        groupCard.querySelector('[data-group-plan-price]').textContent = allocation.price;
        groupCard.querySelector('[data-group-compare-price]').textContent = allocation.comparePrice;
      }

      syncVariant(variantId) {
        const variant = this.variantData[String(variantId)];
        if (!variant) return;

        this.currentVariantId = String(variantId);
        this.dataset.variantId = this.currentVariantId;

        if (this.oneTimePriceOutput) {
          this.oneTimePriceOutput.textContent = variant.oneTimePrice;
        }

        this.groupCards.forEach((groupCard) => this.updateGroupCard(groupCard, variant));

        const selectedPurchase = this.querySelector('[data-purchase-type]:checked');
        const selectedGroup = selectedPurchase?.closest('[data-plan-group]');
        if (selectedGroup?.hidden) {
          const availableGroup = this.groupCards.find((groupCard) => !groupCard.hidden);
          const availableGroupRadio = availableGroup?.querySelector('[data-purchase-type]');
          if (availableGroupRadio) availableGroupRadio.checked = true;
        }

        this.syncPurchaseSelection();
      }

      syncPurchaseSelection() {
        const selectedPurchase = this.querySelector('[data-purchase-type]:checked');
        if (!selectedPurchase || selectedPurchase.value === 'onetime') {
          this.sellingPlanInput.value = '';
          this.sellingPlanInput.disabled = true;
          return;
        }

        const groupCard = selectedPurchase.closest('[data-plan-group]');
        const activeButton = this.getActiveButton(groupCard);
        const variant = this.variantData[this.currentVariantId];
        const allocation = activeButton
          ? this.getAllocation(variant, activeButton.dataset.planId)
          : null;

        if (!allocation) {
          this.sellingPlanInput.value = '';
          this.sellingPlanInput.disabled = true;
          return;
        }

        this.sellingPlanInput.disabled = false;
        this.sellingPlanInput.value = allocation.planId;
      }

      handleClick(event) {
        const clickedButton = event.target.closest('[data-plan-item]');
        if (!clickedButton || !this.contains(clickedButton) || clickedButton.disabled) return;

        const groupCard = clickedButton.closest('[data-plan-group]');
        const buttons = [...groupCard.querySelectorAll('[data-plan-item]')];

        buttons.forEach((button) => {
          const selected = button === clickedButton;
          button.classList.toggle('is-selected', selected);
          button.setAttribute('aria-pressed', String(selected));
        });

        groupCard.querySelector('[data-purchase-type]').checked = true;
        this.updateGroupCard(groupCard, this.variantData[this.currentVariantId]);
        this.syncPurchaseSelection();
      }

      handlePurchaseChange(event) {
        if (event.target.matches('[data-purchase-type]')) {
          this.syncPurchaseSelection();
        }
      }

      handleVariantChange(event) {
        if (!event.target.matches('variant-picker input[data-variant-id]')) return;
        if (!this.productSection?.contains(event.target)) return;
        window.requestAnimationFrame(() => this.syncVariant(event.target.dataset.variantId));
      }
    }

    customElements.define('subscription-widget-controller', SubscriptionWidgetController);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Subscription widget",
  "presets": [
    {
      "name": "Subscription widget"
    }
  ]
}
{% endschema %}
