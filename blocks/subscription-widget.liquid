{%  assign current_varaint  = product.selected_or_first_available_variant %}

<div class="subscription-widget">
<p>current variant {{ current_varaint.id }}</p>
<p>Available Plan {{ current_varaint.selling_plan_allocations.size }}</p>
</div>

{% for allocations in current_varaint.selling_plan_allocations %}

<p>Plan Name :{{  allocations.selling_plan }}</p>
<p>Compare At price :{{  allocations.compare_at_price | money }}</p>
<p>Per Delivery Price: {{  allocations.per_delivery_price | money }}</p>
<p>Price :{{  allocations.price | money }}</p>
<p>Price Adjustments: {{  allocations.price_adjustments }}</p>
<p>Remaining Balance Charge Amount: {{  allocations.remaining_balance_charge_amount }}</p>
<p>Selling Plan Group Id: {{  allocations.selling_plan_group_id }}</p>
<p>Unit Price: {{  allocations.unit_price }}</p>


{% endfor %}

{% schema %}
{
  "name": "Subscription widget",
  "presets": [
    {
      "name": "Subscription widget"
    }
  ]
}
{% endschema %}