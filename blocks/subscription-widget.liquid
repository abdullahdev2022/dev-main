{% assign current_variant = product.selected_or_first_available_variant %}

<div class="subscription-widget">
  <p>Current variant ID: {{ current_variant.id }}</p>

  <p>
    Available plans:
    {{ current_variant.selling_plan_allocations.size }}
  </p>

  {% for allocation in current_variant.selling_plan_allocations %}
    <hr>

    <p>
      Plan name:
      {{ allocation.selling_plan.name }}
    </p>

    <p>
      Plan ID:
      {{ allocation.selling_plan.id }}
    </p>

    <p>
      Compare-at price:
      {{ allocation.compare_at_price | money }}
    </p>

    <p>
      Subscription price:
      {{ allocation.price | money }}
    </p>

    <p>
      Per-delivery price:
      {{ allocation.per_delivery_price | money }}
    </p>

    <p>
      Price-adjustment count:
      {{ allocation.price_adjustments.size }}
    </p>

    <p>
      Remaining balance:
      {{ allocation.remaining_balance_charge_amount | money }}
    </p>

    <p>
      Selling-plan group ID:
      {{ allocation.selling_plan_group_id }}
    </p>

    {% if allocation.unit_price %}
      <p>
        Unit price:
        {{ allocation.unit_price | money }}
      </p>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Subscription widget",
  "presets": [
    {
      "name": "Subscription widget"
    }
  ]
}
{% endschema %}